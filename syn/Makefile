
include mk/asap7.mk

STA_DIR = ../sta
PNR_DIR = ../pnr

export SRC_DIR
export OUT_DIR
export STA_DIR
export NETLIST

VLOG_FLIST =
VLOG_FILES =

YOSYS_FLAGS =

.SUFFIXES:
.SUFFIXES: .tcl

.tcl:
	@VLOG_TOP=$(VLOG_TOP) VLOG_FLIST="$(VLOG_FLIST)" VLOG_FILES="$(VLOG_FILES)" VLOG_DEFINES="$(VLOG_DEFINES)" VLOG_PARAMS="$(VLOG_PARAMS)" TMPDIR=. \
	yosys -m slang $(YOSYS_FLAGS) -QT $<

sta:
	@make VLOG_TOP=$(VLOG_TOP) NETLIST=$(NETLIST) TECH_LIB="$(TECH_LIB)" -C $(STA_DIR) $@

pnr:
	@make VLOG_TOP=$(VLOG_TOP) NETLIST=$(NETLIST) TECH_LIB="$(TECH_LIB)" -C $(PNR_DIR) $@
